; Stick Rush en Godot, con la lógica de `stick-rush/src/lib` ejecutada por GodotJS.
;
; Mismo contrato que `xrcade/examples/hello-xrcade`: todo el contenido cuelga de
; `games/stick-rush/`, porque el paquete se monta sobre la raíz `res://` del hub.

config_version=5

[application]

config/name="Stick Rush (GodotJS)"
run/main_scene="res://games/stick-rush/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true

[xr]

; En macOS no hay runtime de OpenXR: con esto activado, darle a jugar desde el editor en un Mac
; enseña un aviso modal que para el arranque. Los depots (Windows, Linux, Steam Frame) no
; llevan la etiqueta `macos` y siguen con OpenXR.
openxr/enabled=true
openxr/enabled.macos=false
shaders/enabled=true
